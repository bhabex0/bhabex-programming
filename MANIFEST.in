include README.md
include LICENSE
include pyproject.toml
include setup.cfg

recursive-include . *.py
recursive-include . *.bx
recursive-include . *.json
recursive-include . *.toml
recursive-include . *.md
recursive-include . *.txt

recursive-include docs *.md
recursive-include docs *.rst
recursive-include docs *.html
recursive-include docs *.css

recursive-include examples *.bx

recursive-include installer *.sh
recursive-include installer *.nsi
recursive-include installer *.md

recursive-include vscode *.json
recursive-include vscode *.ts
recursive-include vscode *.md
recursive-include vscode *.png
recursive-include vscode *.svg

recursive-include pkg *.rs
recursive-include pkg *.toml

recursive-include compiler *.rs
recursive-include compiler *.toml

graft stdlib

prune __pycache__
prune .git
prune .venv
prune build
prune dist
prune *.egg-info
prune .pytest_cache
prune .mypy_cache
prune .ruff_cache